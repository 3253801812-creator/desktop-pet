root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
# Windows PowerShell 5.1 读 .ps1 需要 BOM
charset = utf-8-bom
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
