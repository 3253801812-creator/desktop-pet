tools/pluginlines.mjs

# 抠图参数存档（记着本机原图路径）
assets/立绘来源.json

# 图像分析的一次性输出（tools/art 跑出来的中间图）
tools/art/out/
*.cut.png
*-checker.png
*-magenta.png

